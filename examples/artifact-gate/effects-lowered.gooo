package gooo_workspace
namespace gooo_workspace

entity EffectBudget id "gooo://automation/effect-budget/v1" fields {
    field allow_target id "gooo://automation/effect-budget/allow-target" type boolean required one
    field allow_session id "gooo://automation/effect-budget/allow-session" type boolean required one
    field allow_filesystem id "gooo://automation/effect-budget/allow-filesystem" type boolean required one
    field allow_process id "gooo://automation/effect-budget/allow-process" type boolean required one
    field allow_network id "gooo://automation/effect-budget/allow-network" type boolean required one
    field allow_ui id "gooo://automation/effect-budget/allow-ui" type boolean required one
    field allow_discard id "gooo://automation/effect-budget/allow-discard" type boolean required one
    field allow_foreign_code id "gooo://automation/effect-budget/allow-foreign-code" type boolean required one
    field allow_device id "gooo://automation/effect-budget/allow-device" type boolean required one
    field require_idempotent id "gooo://automation/effect-budget/require-idempotent" type boolean required one
}
entity EffectBudgetDecision id "gooo://automation/effect-budget-decision/v1" fields {
    field admissible id "gooo://automation/effect-budget-decision/admissible" type boolean required one
    field reason id "gooo://automation/effect-budget-decision/reason" type string required one
    field target_ok id "gooo://automation/effect-budget-decision/target-ok" type boolean required one
    field session_ok id "gooo://automation/effect-budget-decision/session-ok" type boolean required one
    field filesystem_ok id "gooo://automation/effect-budget-decision/filesystem-ok" type boolean required one
    field process_ok id "gooo://automation/effect-budget-decision/process-ok" type boolean required one
    field network_ok id "gooo://automation/effect-budget-decision/network-ok" type boolean required one
    field ui_ok id "gooo://automation/effect-budget-decision/ui-ok" type boolean required one
    field discard_ok id "gooo://automation/effect-budget-decision/discard-ok" type boolean required one
    field foreign_code_ok id "gooo://automation/effect-budget-decision/foreign-code-ok" type boolean required one
    field device_ok id "gooo://automation/effect-budget-decision/device-ok" type boolean required one
    field idempotency_ok id "gooo://automation/effect-budget-decision/idempotency-ok" type boolean required one
}
entity Text id "gooo://std/text"
entity Boolean id "gooo://std/boolean"
entity ToolEffects id "gooo://rea/tool-effects/v1" fields {
    field mutatesTarget id "gooo://rea/tool-effects/mutates-target" type boolean required one
    field mutatesSession id "gooo://rea/tool-effects/mutates-session" type boolean required one
    field writesFilesystem id "gooo://rea/tool-effects/writes-filesystem" type boolean required one
    field launchesProcess id "gooo://rea/tool-effects/launches-process" type boolean required one
    field accessesNetwork id "gooo://rea/tool-effects/accesses-network" type boolean required one
    field changesUiState id "gooo://rea/tool-effects/changes-ui-state" type boolean required one
    field mayDiscardData id "gooo://rea/tool-effects/may-discard-data" type boolean required one
    field executesForeignCode id "gooo://rea/tool-effects/executes-foreign-code" type boolean required one
    field mutatesDevice id "gooo://rea/tool-effects/mutates-device" type boolean required one
    field idempotent id "gooo://rea/tool-effects/idempotent" type boolean required one
}
entity DerivedToolAnnotations id "gooo://rea/derived-tool-annotations/v1" fields {
    field readOnlyHint id "gooo://rea/derived-tool-annotations/read-only-hint" type boolean required one
    field destructiveHint id "gooo://rea/derived-tool-annotations/destructive-hint" type boolean required one
    field idempotentHint id "gooo://rea/derived-tool-annotations/idempotent-hint" type boolean required one
    field openWorldHint id "gooo://rea/derived-tool-annotations/open-world-hint" type boolean required one
}
activity GoooPackage0ActivityEffectBudgetAccepts(ToolEffects, EffectBudget) -> EffectBudgetDecision id "gooo://automation/effect-budget-accepts" computes "\nlet targetOK = !input0.mutatesTarget || input1.allow_target\nlet sessionOK = !input0.mutatesSession || input1.allow_session\nlet filesystemOK = !input0.writesFilesystem || input1.allow_filesystem\nlet processOK = !input0.launchesProcess || input1.allow_process\nlet networkOK = !input0.accessesNetwork || input1.allow_network\nlet uiOK = !input0.changesUiState || input1.allow_ui\nlet discardOK = !input0.mayDiscardData || input1.allow_discard\nlet foreignCodeOK = !input0.executesForeignCode || input1.allow_foreign_code\nlet deviceOK = !input0.mutatesDevice || input1.allow_device\nlet idempotencyOK = !input1.require_idempotent || input0.idempotent\nlet admissible = targetOK && sessionOK && filesystemOK && processOK && networkOK && uiOK && discardOK && foreignCodeOK && deviceOK && idempotencyOK\nlet reason = \"WITHIN_EFFECT_BUDGET\"\nif !targetOK { reason = \"TARGET_MUTATION_DISALLOWED\" } else {\n if !sessionOK { reason = \"SESSION_MUTATION_DISALLOWED\" } else {\n  if !filesystemOK { reason = \"FILESYSTEM_WRITE_DISALLOWED\" } else {\n   if !processOK { reason = \"PROCESS_LAUNCH_DISALLOWED\" } else {\n    if !networkOK { reason = \"NETWORK_ACCESS_DISALLOWED\" } else {\n     if !uiOK { reason = \"UI_CHANGE_DISALLOWED\" } else {\n      if !discardOK { reason = \"DATA_DISCARD_DISALLOWED\" } else {\n       if !foreignCodeOK { reason = \"FOREIGN_CODE_DISALLOWED\" } else {\n        if !deviceOK { reason = \"DEVICE_MUTATION_DISALLOWED\" } else {\n         if !idempotencyOK { reason = \"IDEMPOTENCY_REQUIRED\" }\n        }\n       }\n      }\n     }\n    }\n   }\n  }\n }\n}\nreturn EffectBudgetDecision{admissible: admissible, reason: reason, target_ok: targetOK, session_ok: sessionOK, filesystem_ok: filesystemOK, process_ok: processOK, network_ok: networkOK, ui_ok: uiOK, discard_ok: discardOK, foreign_code_ok: foreignCodeOK, device_ok: deviceOK, idempotency_ok: idempotencyOK}\n"
